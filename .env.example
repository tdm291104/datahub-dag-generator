# Default LLM provider: OpenRouter + openai/gpt-5.2 (configured in llm_models.yaml)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: direct Anthropic key, used with --provider anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# DataHub GMS server URL (default when running locally via docker quickstart)
DATAHUB_SERVER=http://localhost:8080
